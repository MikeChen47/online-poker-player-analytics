{
  "name": "Poker BI Professional",
  "dataColors": ["#1B3A5C", "#4FA3A5", "#C0504D", "#8FA3BF", "#D9A441", "#5B6B82", "#B8C4D6", "#2E5E8C"],
  "background": "#FFFFFF",
  "foreground": "#1B2A41",
  "tableAccent": "#1B3A5C",
  "good": "#4FA3A5",
  "neutral": "#8FA3BF",
  "bad": "#C0504D",
  "maximum": "#1B3A5C",
  "center": "#8FA3BF",
  "minimum": "#EEF1F5",
  "textClasses": {
    "callout": { "fontFace": "Georgia", "fontSize": 26, "color": "#1B2A41" },
    "title":   { "fontFace": "Georgia", "fontSize": 13, "color": "#1B2A41" },
    "header":  { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#1B2A41" },
    "label":   { "fontFace": "Segoe UI", "fontSize": 10, "color": "#5B6B82" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#EEF1F5" } }, "transparency": 0 }],
        "outspace":   [{ "color": { "solid": { "color": "#EEF1F5" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#D5DCE5" } }, "radius": 2 }],
        "valueAxis": [{ "gridlineShow": true, "gridlineColor": { "solid": { "color": "#E6EBF1" } } }],
        "categoryAxis": [{ "gridlineShow": false }]
      }
    }
  }
}
